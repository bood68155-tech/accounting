# X — environment template
# Copy to .env.local and fill in. Everything below is server-side unless
# prefixed with NEXT_PUBLIC_.

# ─── Neon Postgres (https://console.neon.tech) ────────────────────────────────
# Pooled connection string. Dashboard → your project → "Connection Details"
# → choose "Pooled connection". Used by the app, migrations and seed script.
DATABASE_URL=

# ─── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Needed when the app runs behind a proxy (Vercel preview URLs etc.):
AUTH_TRUST_HOST=true

# ─── Google OAuth ("Continue with Google") ───────────────────────────────────
# Create an OAuth client at console.cloud.google.com → APIs & Services →
# Credentials. Authorized redirect URI: <APP_URL>/api/auth/callback/google.
# When both are set, the login/signup pages show the Google button
# (NEXT_PUBLIC_GOOGLE_ENABLED is read by the client UI).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_ENABLED=true

# ─── Email OTP (6-digit verification codes) ──────────────────────────────────
# Option A — Resend API (recommended; no SMTP): dashboard.resend.com → API keys.
# SMTP_FROM is used as the sender when set (must be a verified domain),
# otherwise the resend.dev onboarding sender is used.
RESEND_API_KEY=
# From identity for OTP emails: "EMAIL_FROM_NAME <EMAIL_FROM>". EMAIL_FROM must
# be a domain VERIFIED in your Resend account for reliable inbox delivery — the
# resend.dev sandbox only delivers to the account owner.
EMAIL_FROM=
EMAIL_FROM_NAME=StoreAccountant
# Optional Reply-To for OTP emails.
EMAIL_REPLY_TO=
# While Resend runs in testing-sandbox mode (no verified domain), error
# messages name the ONE address that can receive codes. Set this to the
# Resend account owner's email so users know which address works.
OTP_SANDBOX_OWNER_EMAIL=
# Option B — Gmail app password (enable 2FA, then generate an app password):
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Display name for OTP emails sent via Gmail: "NAME <GMAIL_USER>". The From
# address must stay strictly GMAIL_USER (Gmail requirement + spam filtering).
EMAIL_FROM_NAME=StoreAccountant
# Option C — any SMTP server (Mailgun, SES…):
SMTP_URL=
SMTP_FROM=
# With no transport configured, codes are printed to the server console
# (dev/test convenience — the UI also shows the code in non-production).
# If a Resend send FAILS in dev/test/preview (e.g. the testing sender only
# delivers to the account owner), the code is logged to the server console AND
# returned via devCode so ANY email address can complete signup/login.
# In production a failed send is a clean error — no code is ever exposed.

# ─── Email OTP rate limits ──────────────────────────────────────────────
# Resend cooldown between codes: 5s automatically in dev/test/Vercel preview
# (NODE_ENV=development/test or VERCEL_ENV=preview), 45s in production.
# Window limit stays 3 codes / 15 min per email+purpose in all environments.

# ─── Email OTP dev bypass (DANGER — local/dev only) ───────────────────────────
# Set a fixed 6-digit code (e.g. 123456) that verifies ANY email without any
# email being sent — login and signup work immediately, no Resend/SMTP needed.
# IGNORED in production unless OTP_ALLOW_INSECURE_MASTER_CODE=true is also set
# (never do that on a public deployment).
OTP_DEV_MASTER_CODE=
OTP_ALLOW_INSECURE_MASTER_CODE=

# ─── Store provider webhook secrets ────────────────────────────────────────────
# Shopify: app settings → API access → Webhook secret (used to verify HMAC).
SHOPIFY_WEBHOOK_SECRET=
# Salla: Partner dashboard → webhooks → signature secret (HMAC-SHA256 hex).
SALLA_WEBHOOK_SECRET=

# ─── Catalog sync (Admin API tokens; also settable per store in the UI) ───────
# Shopify custom-app Admin API access token (shpat_…) for product/cost sync.
SHOPIFY_ADMIN_TOKEN=
# Salla access token (OAuth2 or personal) scoped to products.read.
SALLA_ACCESS_TOKEN=
# Stripe: Dashboard → Developers → Webhooks → your endpoint → signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=
# PayPal: App & Credentials → Webhook ID (used to verify webhook identity).
PAYPAL_WEBHOOK_ID=
# WooCommerce: a REST API consumer key/secret for order sync (optional).
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# ─── App ───────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to connect stores (CORS for webhooks).
NEXT_PUBLIC_APP_URL=

# ─── Admin console ─────────────────────────────────────────────────────────────
# Platform owner email is hardcoded (bood68155@gmail.com). Additional emails
# can be added here as comma-separated values.
ADMIN_EMAILS=
# PIN required to unlock /admin (server-side only; defaults to 222222 when unset).
# Prefer a longer value in production.
ADMIN_PIN=

# ─── Seed script (optional) ────────────────────────────────────────────────────
# The account that should own the demo tenant (defaults to the admin email).
SEED_USER_EMAIL=

# ─── AI (optional) ─────────────────────────────────────────────────────────────
# When set, the AI assistant uses OpenAI to phrase answers over grounded,
# deterministic tool outputs. Without a key the assistant still works using the
# built-in deterministic engine — numbers never depend on the LLM.
OPENAI_API_KEY=

# ─── Daily digest notifications (WhatsApp / Telegram) ─────────────────────────
# Shared secret for POST /api/notifications/daily-digest. The endpoint refuses to
# run without it, and Vercel Cron sends it automatically as `Authorization:
# Bearer $CRON_SECRET` when the variable is set. Required for the digest job.
CRON_SECRET=

# Telegram — from @BotFather. A digest target is a numeric chat id (or an
# @public_channel_username); get a group's id by adding the bot and reading
# https://api.telegram.org/bot<TOKEN>/getUpdates. Without a token the channel is
# reported as "skipped" in the run log, never as a hard failure.
TELEGRAM_BOT_TOKEN=

# Telegram bot handle (no @) — used to build the owner-facing connect link
# t.me/<bot>?start=<token> that Settings hands out. Optional: when this is empty
# the app falls back to the default handle bood_store_bot. Set it only to point
# the connect button at a different bot (staging, or a rename).
TELEGRAM_BOT_USERNAME=

# Shared secret for POST /api/telegram/webhook. Register it with Telegram:
#   curl -X POST "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" \
#        -d url="$NEXT_PUBLIC_APP_URL/api/telegram/webhook" \
#        -d secret_token="$TELEGRAM_WEBHOOK_SECRET"
# The endpoint rejects every request without it, so /start <token> binding
# cannot be forged. Compared in constant time.
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API — from the Meta developer dashboard → WhatsApp → API setup.
# WHATSAPP_PHONE_NUMBER_ID is the sender's business phone number id. Recipients
# are entered in international format (e.g. +966501234567); digits are stripped
# before the send. Without these the channel is skipped, as above.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ─── Automated crypto payment gateway (USDT · NOWPayments) ─────────────────────
# API key from the NOWPayments dashboard (Store settings → API keys). Used to
# create hosted USDT/crypto invoices. When set, /renew shows an automatic
# checkout that activates the subscription on confirmation — no admin step.
CRYPTO_PAYMENT_API_KEY=
# IPN secret from the NOWPayments dashboard (Store settings → IPN). Verifies the
# `x-nowpayments-sig` header (HMAC-SHA512) on POST /api/webhooks/payments so only
# genuine payment confirmations can flip a payment to approved.
CRYPTO_WEBHOOK_SECRET=

# ─── LinkedIn agent (scripts/linkedin-agent · src/lib/linkedin-agent) ──────────
# Session cookie from a logged-in linkedin.com browser session: DevTools →
# Application → Cookies → https://www.linkedin.com → copy the `li_at` value.
# This is a LIVE credential — it can post and message as you. Server-side only,
# never expose it to the browser. Treat it like a password.
LINKEDIN_LI_AT_COOKIE=
# The `JSESSIONID` cookie value, used verbatim as the `csrf-token` header the
# private Voyager API requires (surrounding quotes are stripped automatically).
LINKEDIN_JSESSIONID=
# Master switch for real HTTP calls to LinkedIn (`leads` / `share`). Default OFF.
# WARNING: automating LinkedIn with a session cookie violates its User Agreement
# and can get the account restricted. The safe path is content generation only —
# the humanizer, the detector and the draft/prep actions never touch the network.
LINKEDIN_AGENT_ENABLE_HTTP=false
# Shared secret for POST /api/linkedin/webhook (Bearer token). Without it the
# endpoint refuses every request. Generate with: openssl rand -base64 32
# (Pre-rename `LINKEDIN_WEBHOOK_SECRET` is still accepted as an alias.)
LINKEDIN_AGENT_WEBHOOK_SECRET=
# Optional path to a voice profile. Copy scripts/linkedin-agent/upstream/templates/voice.md
# to a repo-local file and point this at it so drafts sound like you.
LINKEDIN_VOICE_PATH=
