{
  "name": "x",
  "version": "0.1.0",
  "private": true,
  "description": "X — Automated AI Accounting & Profitability Engine for E-commerce Stores",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:push": "node --env-file-if-exists=.env.local scripts/apply-migrations.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/apply-migrations.mjs",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-demo-data.mjs",
    "db:purge-demo": "node --env-file-if-exists=.env.local scripts/purge-demo-data.mjs",
    "stores:validate-tokens": "node --env-file-if-exists=.env.local scripts/validate-store-tokens.mjs",
    "webhooks:replay": "node --env-file-if-exists=.env.local scripts/run-ts.mjs scripts/replay-webhooks.ts",
    "webhooks:listen": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "test:shopify": "node scripts/run-ts.mjs scripts/verify-shopify-pipeline.ts",
    "test:salla": "node scripts/run-ts.mjs scripts/verify-salla-pipeline.ts",
    "webhook:simulate": "node --env-file-if-exists=.env.local scripts/simulate-shopify-webhook.mjs",
    "webhook:simulate-salla": "node --env-file-if-exists=.env.local scripts/simulate-salla-webhook.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
