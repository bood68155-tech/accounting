    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Score each person returned by the `leads` action. The Voyager payload shape is\n// undocumented, so every lookup is defensive: a missing or renamed field means\n// fewer leads, never a crashed run.\nconst payload = $input.first()?.json?.data ?? {};\nconst keywords = String(payload.keywords ?? '')\n  .toLowerCase()\n  .split(/\\W+/)\n  .filter((word) => word.length > 4);\n\nconst raw = payload.result?.elements ?? payload.result ?? [];\nconst leads = Array.isArray(raw) ? raw : [];\n\nconst text = (value) => {\n  if (typeof value === 'string') return value;\n  if (value && typeof value.text === 'string') return value.text;\n  if (value && typeof value.localized === 'object') {\n    return Object.values(value.localized).find((v) => typeof v === 'string') ?? '';\n  }\n  return '';\n};\n\nreturn leads.map((item) => {\n  const profile = item?.memberSummary ?? item?.miniProfile ?? item ?? {};\n  const name =\n    [text(profile.firstName), text(profile.lastName)].filter(Boolean).join(' ') ||\n    text(profile.name) ||\n    'Unknown';\n  const headline =\n    text(profile.headline) || text(profile.occupation?.title) || text(profile.title);\n  const haystack = `${name} ${headline}`.toLowerCase();\n\n  const matched = keywords.filter((word) => haystack.includes(word)).length;\n  const senior = /owner|founder|ceo|head of|director|cfo|accountant/.test(haystack) ? 15 : 0;\n  const score = Math.min(99, 40 + matched * 30 + senior);\n\n  return { json: { name, headline, score, keywords: payload.keywords } };\n});"
      },
      "id": "a1f0c2e0-0005-4000-8000-000000000005",
      "name": "Score Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [740, 460]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "high-score-threshold",
              "leftValue": "={{ $json.score }}",
              "rightValue": 70,
              "operator": {
                "type": "number",
                "operation": "gte",
                "singleValue": false
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
