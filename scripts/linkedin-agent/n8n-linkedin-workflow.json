      "id": "a1f0c2e0-0004-4000-8000-000000000004",
      "name": "Fetch Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 460],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
